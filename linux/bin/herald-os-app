#!/usr/bin/env bash
# Jarod-OS as an app inside another Wayland compositor (Hyprland, Omarchy): the single-window shell,
# fullscreen as on macOS, with the compositor's own bar and keys around it. The full Jarod-OS session
# (niri, menu bar and dock) starts from the login screen through herald-os-session instead.
set -u

# Variables renamed with Jarod-OS (2026-10-19): an older HERALD_OS_* still counts when JAROD_OS_* is unset (the new name wins).
# HERALD_OS_DEV_UNSIGNED keeps its name (contract c8). Only names are handled here; no value is printed.
for _old in $(compgen -e); do
  case "$_old" in
    HERALD_OS_DEV_UNSIGNED) ;;
    HERALD_OS_*) _new="JAROD_OS_${_old#HERALD_OS_}"; [[ -n "${!_new+x}" ]] || export "$_new=${!_old}" ;;
  esac
done
unset _old _new

flags=(--class=herald-os --ozone-platform=wayland)

for app in "${JAROD_OS_APP:-}" /opt/herald-os /usr/share/herald-os/app; do
  if [[ -n "$app" && -x "$app/herald-os" && -f "$app/resources/app.asar" ]]; then
    exec "$app/herald-os" "${flags[@]}" "$@"
  fi
done

# A source checkout (development): npm workspaces hoist Electron to the repo root.
repo="${JAROD_OS_REPO:-$HOME/Herald-OS}"
if [[ -x "$repo/node_modules/.bin/electron" && -f "$repo/apps/desktop/dist/electron/main.mjs" ]]; then
  exec "$repo/node_modules/.bin/electron" "$repo/apps/desktop" "${flags[@]}" "$@"
fi

echo "herald-os-app: Jarod-OS is not installed (no /opt/herald-os); see docs/LINUX.md" >&2
exit 1
