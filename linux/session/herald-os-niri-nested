#!/usr/bin/env bash
# Runs inside cage on machines without hardware GL: starts niri's windowed backend, which cage
# shows fullscreen. niri then spawns herald-os-session (spawn-at-startup) and manages every window.
set -u

# Variables renamed with Jarod-OS (2026-10-19): an older HERALD_OS_* still counts when JAROD_OS_* is unset (the new name wins).
# HERALD_OS_DEV_UNSIGNED keeps its name (contract c8). Only names are handled here; no value is printed.
for _old in $(compgen -e); do
  case "$_old" in
    HERALD_OS_DEV_UNSIGNED) ;;
    HERALD_OS_*) _new="JAROD_OS_${_old#HERALD_OS_}"; [[ -n "${!_new+x}" ]] || export "$_new=${!_old}" ;;
  esac
done
unset _old _new

export JAROD_OS_SHELL_MODE=panels
unset JAROD_OS_KIOSK JAROD_OS_ZOOM
# cage's software renderer is the outer layer; niri's own GL goes through Mesa's EGL on Wayland.
unset WLR_RENDERER
export LIBGL_ALWAYS_SOFTWARE=1

exec niri --config "$HOME/.config/niri/config.kdl"
