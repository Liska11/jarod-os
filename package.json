{
  "name": "herald-os",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Jarod-OS: an agent-native operating system built on Hermes Agent.",
  "license": "MIT",
  "author": "Luke The Dev",
  "homepage": "https://github.com/iamlukethedev/Herald-OS",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamlukethedev/Herald-OS.git"
  },
  "bugs": "https://github.com/iamlukethedev/Herald-OS/issues",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "dbus-next": {
      "xml2js": "0.6.2"
    },
    "usocket": {
      "node-gyp": "12.4.0"
    }
  },
  "allowScripts": {
    "node-pty": true,
    "esbuild": true,
    "usocket": true,
    "electron-winstaller": false
  },
  "scripts": {
    "bootstrap": "node scripts/run.mjs bootstrap",
    "sync-upstream": "node scripts/run.mjs sync-upstream",
    "dev": "npm run dev --workspace apps/desktop",
    "build": "npm run build --workspace apps/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "biome lint",
    "typecheck:core": "pnpm --dir jarod-core -r typecheck",
    "test:core": "pnpm --dir jarod-core -r test",
    "test:bridge": "node scripts/run.mjs test-bridge",
    "dist:mac": "npm run dist:mac --workspace apps/desktop",
    "dist:win": "npm run dist:win --workspace apps/desktop"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  }
}
