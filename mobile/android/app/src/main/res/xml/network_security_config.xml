<?xml version="1.0" encoding="utf-8"?>
<!--
  The PC is reached by IP address (LAN or Tailscale), so cleartext HTTP must be allowed; what it
  carries is the end-to-end channel's ciphertext. No user-installed certificate authority is trusted.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
