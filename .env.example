# Jarod-OS settings that come from the environment. All are optional and the defaults suit most
# people, so every line here is commented out.
#
# Older names are still read: HERALD_OS_* counts when the JAROD_OS_* of the same name is unset (the new
# name wins). HERALD_OS_DEV_UNSIGNED keeps that name (it is fixed by a contract).
#
# Nothing loads this file automatically:
#   macOS: export the variables you want before `npm run dev` (or `npm start`).
#   Linux: copy the lines you want into ~/.config/herald-os/session.env, then
#          `sudo systemctl restart greetd`.
#
# Never put credentials here. Hermes Agent keeps API keys and logins in ~/.hermes (run `hermes setup`
# or open Settings in Jarod-OS), and the shell never needs them.
#
# Names written before the rename (HERMES_OS_*) are still read.

# ---- Shell window ----

# Kiosk window: no way to leave fullscreen.
# JAROD_OS_KIOSK=1

# Start windowed instead of fullscreen.
# JAROD_OS_WINDOWED=1

# Page zoom for the whole shell.
# JAROD_OS_ZOOM=1.25

# desktop (one window, the default) or panels (one window per surface, used by the niri session).
# JAROD_OS_SHELL_MODE=desktop

# ---- Hermes backend ----

# Hermes Agent checkout to run `hermes serve` from (default: ~/.hermes/hermes-agent).
# JAROD_OS_HERMES_ROOT=/path/to/hermes-agent

# Working directory for new sessions (default: your home folder).
# JAROD_OS_DEFAULT_CWD=/path/to/projects

# Turn off the herald-os-bridge plugin (desktop tools, UI control) without uninstalling it.
# JAROD_OS_BRIDGE_DISABLED=1

# Hermes home, if not ~/.hermes. Read by Hermes itself, the shell and the bridge.
# HERMES_HOME=/path/to/.hermes

# ---- Development ----

# Load the renderer from a Vite dev server instead of the built files. `npm run dev` sets this.
# JAROD_OS_DEV_SERVER=http://127.0.0.1:5180

# Chrome DevTools protocol port, for scripted checks.
# JAROD_OS_REMOTE_DEBUG_PORT=9333

# ---- Linux session (session.env) ----

# Compositor: niri (panels, the default) or cage (one fullscreen window).
# JAROD_OS_COMPOSITOR=niri

# Run niri nested inside another Wayland session: 0, 1 or auto.
# JAROD_OS_NIRI_NESTED=auto

# Display scale for HiDPI screens (1.5 for 2048x1280, 2 for 2880x1800): niri's output scale, or
# the page zoom under cage.
# JAROD_OS_SCALE=1.5

# Lock the screen, then turn it off, after this many idle seconds.
# JAROD_OS_LOCK_AFTER=600
# JAROD_OS_SCREEN_OFF_AFTER=900

# Software rendering. Turned on automatically when there is no GPU render node (most VMs).
# JAROD_OS_SOFTWARE_GPU=1

# Disable Chromium's sandbox, only if user namespaces are unavailable.
# JAROD_OS_NO_SANDBOX=1

# Alternate shell build, or Electron binary.
# JAROD_OS_APP=/path/to/apps/desktop
# JAROD_OS_ELECTRON=/path/to/electron

# Checkout that herald-os-update pulls from (default: ~/Herald-OS).
# JAROD_OS_REPO=/path/to/Herald-OS
