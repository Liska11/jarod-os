{
  "name": "@jarod-os/desktop",
  "productName": "Jarod-OS",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "The Jarod-OS shell: menu bar, dock, windows and apps for an agent-native operating system.",
  "author": "Jarod-OS",
  "copyright": "Copyright © 2026 Jarod-OS — dérivé de Herald OS (© 2026 Luke The Dev, licence MIT)",
  "license": "MIT",
  "type": "module",
  "main": "dist/electron/main.mjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n renderer,electron -c cyan,yellow \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "dev:electron": "wait-on http://127.0.0.1:5180 && node scripts/bundle-electron.mjs --dev && node scripts/run-electron.mjs --dev-server http://127.0.0.1:5180",
    "build": "vite build && node scripts/bundle-electron.mjs",
    "start": "npm run build && electron .",
    "bundle:core": "node scripts/bundle-core.mjs",
    "bundle:pinokio": "node scripts/bundle-pinokio.mjs",
    "bundle:restic": "node scripts/bundle-restic.mjs",
    "bundle:updater": "node scripts/bundle-updater.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dist:mac": "npm run bundle:core && npm run build && electron-builder --mac --arm64 -c.npmRebuild=false --publish never",
    "dist:linux": "npm run bundle:core && npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run bundle:core && npm run bundle:pinokio && npm run bundle:restic && npm run bundle:updater && npm run build && electron-builder --win --x64 -c.npmRebuild=false --publish never",
    "i18n:report": "node scripts/i18n-report.mjs"
  },
  "dependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@jarod-os/client": "*",
    "@nanostores/react": "2.0.1",
    "@playwright/test": "^1.64.1",
    "@tabler/icons-react": "3.50.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "ajv": "^8.20.0",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "concurrently": "10.0.6",
    "dbus-next": "0.10.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "nanostores": "1.5.5",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wait-on": "9.5.1"
  },
  "build": {
    "appId": "one.jarod.os",
    "productName": "Jarod-OS",
    "executableName": "Jarod-OS",
    "artifactName": "JarodOS-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json",
      "!**/node_modules/usocket/**",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "../../linux/themes",
        "to": "themes"
      },
      {
        "from": "../../linux/catalog",
        "to": "catalog"
      },
      {
        "from": "../../jarod-core/dist/gateway",
        "to": "jarod-core"
      },
      {
        "from": "../../jarod-core/dist/gateway/node_modules",
        "to": "jarod-core/node_modules"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/node-pty/prebuilds/**"
    ],
    "electronLanguages": [
      "en-US",
      "fr"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "../../plugins/herald-os-bridge",
          "to": "herald-os-bridge",
          "filter": [
            "**/*",
            "!tests/**",
            "!**/__pycache__/**",
            "!.pytest_cache/**"
          ]
        }
      ],
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Jarod-OS controls applications on your behalf when you ask it to.",
        "NSMicrophoneUsageDescription": "Jarod-OS uses the microphone for voice input.",
        "NSCameraUsageDescription": "Jarod-OS shows your camera in a bubble while you record the screen, when you turn it on."
      }
    },
    "dmg": {
      "sign": false
    },
    "linux": {
      "category": "System",
      "icon": "build/icon.png",
      "executableName": "herald-os",
      "artifactName": "herald-os-${version}-linux-${arch}.${ext}",
      "target": [
        "tar.gz"
      ],
      "extraResources": [
        {
          "from": "../../linux",
          "to": "herald-os-linux",
          "filter": [
            "bin/**",
            "session/**",
            "niri/**",
            "omakase/**",
            "migrations/**",
            "plymouth/**",
            "!**/__pycache__/**"
          ]
        },
        {
          "from": "build/icon.png",
          "to": "icons/herald-os.png"
        },
        {
          "from": "../../plugins/herald-os-bridge",
          "to": "herald-os-bridge",
          "filter": [
            "**/*",
            "!tests/**",
            "!**/__pycache__/**",
            "!.pytest_cache/**"
          ]
        }
      ],
      "desktop": {
        "entry": {
          "Name": "Jarod-OS",
          "Comment": "Agent-native desktop powered by Hermes Agent",
          "Categories": "System;"
        }
      }
    },
    "win": {
      "icon": "build/icon.png",
      "artifactName": "JarodOS-${version}-win-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "../../plugins/herald-os-bridge",
          "to": "herald-os-bridge",
          "filter": [
            "**/*",
            "!tests/**",
            "!**/__pycache__/**",
            "!.pytest_cache/**"
          ]
        },
        {
          "from": "../../pinokio-runtime",
          "to": "pinokiod",
          "filter": [
            "host.cjs",
            "package.json"
          ]
        },
        {
          "from": "../../pinokio-runtime/node_modules",
          "to": "pinokiod/node_modules"
        },
        {
          "from": "../../engines/restic/bundle",
          "to": "restic"
        },
        {
          "from": "../../host-rust/target/updater-bundle",
          "to": "updater"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Jarod-OS",
      "artifactName": "JarodOS-Setup-${version}-win-${arch}.${ext}"
    },
    "appx": {
      "identityName": "Jarod.OS",
      "publisher": "CN=JarodOS",
      "publisherDisplayName": "Jarod-OS",
      "displayName": "Jarod-OS",
      "backgroundColor": "#07080a"
    }
  }
}
